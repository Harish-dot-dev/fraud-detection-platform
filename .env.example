# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. .env is gitignored; this file is not.
# Never put a real secret in .env.example.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Kafka -----------------------------------------------------------------
# Inside the Docker network use kafka:9092. From your laptop (e.g. running the
# producer outside Compose) use localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092
KAFKA_TOPIC_PAYMENTS=payments
KAFKA_TOPIC_DECISIONS=decisions

# --- Producer --------------------------------------------------------------
# The IEEE-CIS TransactionDT column is a seconds offset, not a timestamp. We map
# it onto a synthetic calendar starting at this date so the data has a real
# timeline (see docs/design_decisions.md).
SYNTHETIC_EPOCH=2023-01-01T00:00:00Z
# How much faster than real time to replay. 3600 = one hour of history per second.
REPLAY_SPEEDUP=3600
# Cap the number of transactions replayed (0 = all). Useful on a small laptop.
PRODUCER_MAX_EVENTS=0

# --- Redis (online feature store) ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Online features expire so a stale card profile cannot be scored against.
REDIS_FEATURE_TTL_SECONDS=172800

# --- Storage ---------------------------------------------------------------
# Delta Lake medallion layers and the DuckDB warehouse file, relative to repo root.
DELTA_BRONZE_PATH=data/delta/bronze
DELTA_SILVER_PATH=data/delta/silver
DELTA_GOLD_PATH=data/delta/gold
DELTA_DECISIONS_PATH=data/delta/decisions
# Labels (chargebacks) and the point-in-time training set built from them.
DELTA_CHARGEBACKS_PATH=data/delta/chargebacks
DELTA_TRAINING_PATH=data/delta/training
DUCKDB_PATH=data/warehouse/fraud.duckdb

# --- PII ------------------------------------------------------------------
# Salt for the card-identity tokenisation applied in the Silver layer. Generate
# your own with:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it invalidates every previously issued token.
PII_HASH_SALT=change-me-generate-a-random-64-char-hex-string

# --- MLflow ---------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=fraud-xgboost
MLFLOW_REGISTERED_MODEL=fraud-xgboost
# Alias of the model the serving API loads.
MLFLOW_CHAMPION_ALIAS=champion

# --- Serving --------------------------------------------------------------
SCORING_API_URL=http://api:8000
SCORING_API_URL_HOST=http://localhost:8000
# Two thresholds give three decisions: allow / review / block.
# These defaults are placeholders; training/tune_thresholds.py overwrites them
# with cost-optimal values and writes the result to reports/thresholds.json.
THRESHOLD_REVIEW=0.30
THRESHOLD_BLOCK=0.80
# Cost model used to choose the thresholds above.
# Cost of a missed fraud = the transaction amount. Cost of wrongly blocking a
# good customer = this fixed friction cost (support call, churn risk).
COST_FALSE_BLOCK=25.0
# Fixed handling cost of sending one payment to a human analyst queue.
COST_REVIEW=5.0

# --- GenAI ----------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
# Keep this small: 3b fits comfortably on a 16 GB laptop.
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_DB=fraud_cases
PGVECTOR_USER=fraud
PGVECTOR_PASSWORD=fraud_local_dev_only
# How many similar past cases to retrieve per flagged payment.
RAG_TOP_K=5

# --- Labels ---------------------------------------------------------------
# Chargebacks arrive late. Fraud is confirmed somewhere in this window after the
# transaction; non-fraud is only trusted once the dispute window has closed.
CHARGEBACK_MIN_DELAY_DAYS=7
CHARGEBACK_MAX_DELAY_DAYS=60
LABEL_MATURITY_DAYS=60

# --- Dashboard (optional Superset) -----------------------------------------
SUPERSET_ADMIN=admin
SUPERSET_PASSWORD=admin
SUPERSET_SECRET_KEY=change-me-generate-a-random-string

# --- Reproducibility -------------------------------------------------------
RANDOM_SEED=42
